<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- The game's C# part: the server connection (game/net/DaocClient.cs); the rest of the game is GDScript. Build with
       the .NET SDK (offline: nuget.config points at the Godot .NET build's own packages in tools\godot_net). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <RootNamespace>MMOEngine</RootNamespace>
  </PropertyGroup>
</Project>
